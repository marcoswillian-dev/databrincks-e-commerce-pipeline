   },
   "outputs": [],
   "source": [
    "from pyspark.sql import functions as F\n",
    "\n",
    "null_counts = df.select(\n",
    "    *[\n",
    "        F.sum(F.col(c).isNull().cast(\"int\")).alias(c)\n",
    "        for c in df.columns\n",
    "    ]\n",
    ")\n",
    "\n",
    "display(null_counts)"
   ]
  }
